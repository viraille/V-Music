{
  "name": "V-Music",
  "version": "26.10.31",
  "description": "Client desktop YouTube Music maison, avec bloqueur de pub réseau et interface custom",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "node scripts/dist-win.js"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.18.2",
    "electron-store": "^8.1.0"
  },
  "devDependencies": {
    "electron": "^44.10.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.custom.ytmusic",
    "productName": "V Music",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "discord.js",
      "velvetone.js",
      "neo/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
